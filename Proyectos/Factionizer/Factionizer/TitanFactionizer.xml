<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">
	<Script file="TitanFactionizer.lua"/>
	<Frame parent="UIParent">
		<Frames>
			<Button name="TitanPanelFactionizerButton" inherits="TitanPanelComboTemplate" frameStrata="FULLSCREEN" toplevel="true">
				<Scripts>
					<OnLoad>
						TitanPanelFactionizerButton_OnLoad(self);
						TitanPanelButton_OnLoad(self);
					</OnLoad>
					<OnShow>
						TitanPanelFactionizerButton_OnShow();
						TitanPanelButton_OnShow(self);
					</OnShow>
					<OnClick>
						TitanPanelFactionizerButton_OnClick(self, button);
					</OnClick>
					<OnEnter>
						TitanPanelButton_OnEnter(self);
					</OnEnter>
					<OnLeave>
						TitanPanelButton_OnLeave(self);
					</OnLeave>
					<OnEvent>
						TitanPanelFactionizerButton_OnEvent(self, event, ...);
					</OnEvent>
					<OnUpdate>
						TitanPanelFactionizerButton_OnUpdate(self, elapsed);
					</OnUpdate>
				</Scripts>
			</Button>
		</Frames>
	</Frame>
</Ui>
