tinsert(l,m(485,g({description="|cff66ccffNorthrend is the northern, icy continent of the world of Azeroth, and the source of the evil Scourge. It is also the home of Icecrown Citadel, the seat of the malevolent Lich King.|r",achievementID=45,icon="Interface\\Icons\\Achievement_Zone_Northrend_01"},{m(504,g({isRaid=true,description="|cff66ccffDalaran is a magocratic city-state and was once located within the Alterac Mountains in the Eastern Kingdoms. Now, the city, including the Violet Citadel, resides above the Crystalsong Forest in Northrend. The top part of the city is sparkling and airy, while the sewers underground show the darker side of magic addiction and luxury.|r",lvl=58,icon="Interface\\Icons\\spell_arcane_teleportdalaran"},{faction(1090,g({achievementID=1008},{n(32287,{s(20874,43157,{b=1,f=9}),r(53946,{itemID=41718,b=1,requireSkill=755}),r(56011,{itemID=42188,b=1,requireSkill=197}),s(21366,44173,{b=1,lvl=80,f=20}),s(21360,44166,{b=1,lvl=78,f=20}),s(21367,44174,{b=1,lvl=80,f=28}),s(21363,44170,{b=1,lvl=78,f=5}),s(21364,44171,{b=1,lvl=78,f=6}),s(21370,44180,{b=1,lvl=80,f=4}),s(21361,44167,{b=1,lvl=78,f=3}),s(21373,44183,{b=1,lvl=80,f=7}),s(21371,44181,{b=1,lvl=80,f=5}),s(21368,44176,{b=1,lvl=80,f=7}),s(21369,44179,{b=1,lvl=80,f=5}),s(21372,44182,{b=1,lvl=80,f=6})})})),faction(1094,g({creatureID=30115,races=a1},{n(31579,g({races=a1},{i(40637,g({b=1,lvl=80,c=a18,f=58},{s(19442,40459,{b=1,c=a5,f=4}),s(19433,40450,{b=1,c=a5,f=4}),s(19414,40424,{b=1,c=a8,f=4}),s(19550,40584,{b=1,c=a4,f=7}),s(19545,40578,{b=1,c=a4,f=7}),s(19540,40573,{b=1,c=a4,f=7})})),i(40638,g({b=1,lvl=80,c=a27,f=58},{s(19480,40507,{b=1,c=a11,f=6}),s(19516,40548,{b=1,c=a6,f=7}),s(19503,40530,{b=1,c=a6,f=7}),s(19497,40524,{b=1,c=a3,f=6}),s(19491,40518,{b=1,c=a3,f=6}),s(19486,40513,{b=1,c=a3,f=6})})),i(40639,g({b=1,lvl=80,c=a20,f=58},{s(19475,40502,{b=1,c=a9,f=5}),s(19453,40470,{b=1,c=a2,f=5}),s(19468,40494,{b=1,c=a2,f=5}),s(19448,40465,{b=1,c=a2,f=5}),s(19409,40419,{b=1,c=a10,f=4}),s(19535,40568