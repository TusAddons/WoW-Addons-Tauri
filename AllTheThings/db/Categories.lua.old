08153},description="Pirates in southern-east Azsuna.",b=1,f=104}),crit(11,{achievementID=11139,itemID=139520,qgs={111586,111598,111630},description="Murlocs at the southern tip in Azsuna.",b=1,f=104}),crit(15,{achievementID=11139,itemID=139521,qgs={88099,88101,108146},description="Murlocs on the left coast of the lake surrounding Nar'thalos Academy.",b=1,f=104})}))})),n(-25,{p(1708),p(706),p(1914),p(396),p(1774),p(1773),p(1731),p(1709),p(1710),p(478),p(464),p(647),p(699),p(1728),p(1583),p(1729),p(743),p(1587),p(1736),p(1935),n(115741,g({description="1. Buy Azsunian Grapes from Nalysse Dawnsorrow in Azsuna.\n2. Kill Bloodgazer Matriarch.\n3. /target Orphaned Bloodgazer\n4. Feed Orphaned Bloodgazer Azsunian Grapes.\n5. Enjoy new Bloodgazer Hatchling|r"},{p(1977),q(45008,{toy(142494,{b=1})}),q(45020,{mnt(213158,{itemID=137577,b=1,lvl=20})})}))}),n(-169,{q(42420,{i(157825,g({b=1,f=58},{n(-322,{s(80928,134334,{b=1,lvl=101,f=3}),s(80925,134246,{b=1,lvl=101,f=3})}),n(-3241,{s(77612,134348,{b=1,lvl=101,f=4}),s(77617,134353,{b=1,lvl=101,f=4}),s(77615,134351,{b=1,lvl=101,f=4}),s(77618,134354,{b=1,lvl=101,f=4}),s(77613,134349,{b=1,lvl=101,f=4}),s(77611,134347,{b=1,lvl=101,f=4}),s(77614,134350,{b=1,lvl=101,f=4}),s(77616,134352,{b=1,lvl=101,f=4})}),n(-3248,{s(77544,134260,{b=1,lvl=101,f=4}),s(77549,134265,{b=1,lvl=101,f=4}),s(77547,134263,{b=1,lvl=101,f=4}),s(77550,134266,{b=1,lvl=101,f=4}),s(77545,134261,{b=1,lvl=101,f=4}),s(77543,134259,{b=1,lvl=101,f=4}),s(77546,134262,{b=1,lvl=101,f=4}),s(77548,134264,{b=1,lvl=101,f=4})}),n(-3271,{s(77531,134240,{b=1,lvl=101,f=5}),s(77533,134242,{b=1,lvl=101,f=5}),s(77532,134241,{b=1,lvl=101,f=5}),s(77527,134236,{b=1,lvl=101,f=5}),s(77530,134239,{b=1,lvl=101,f=5}),s(77534,134243,{b=1,lvl=101,f=5}),s(77529,134238,{b=1,lvl=101,f=5}),s(77528,134237,{b=1,lvl=101,f=5})}),n(-3264,{s(77599,134328,{b=1,lvl=101,f=5}),s(77601,134330,{b=1,lvl=101,f=5}),s(77600,134329,{b=1,lvl=101,f=5}),s(77595,134324,{b=1,lvl=101,f=5}),s(77598,134327,{b=1,lvl=101,f=5})