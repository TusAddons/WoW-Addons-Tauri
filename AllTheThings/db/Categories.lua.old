tinsert(l,m(1184,g({description="Argus hovers on the border of the Twisting Nether and the physical universe, saturated with the fel energies of the Burning Legion.\n\nThe area of Argus that Illidan Stormrage visited during the War in Outland was once a beautiful place of crystalline mountains and shimmering seas, but is now cold and cruel with a sense of corruption and loss. Jagged crystal mountains hold festering corruption within that cause them to crumble, and dust devils born of the powdered gems screech down canyons of serrated rock which refract light everywhere. There is a city which looms over canyons of fractured crystal and is laid out according to complex geomantic rules. The buildings resemble those of the draenei but far more grandiose. At the center of the city is a mighty palace that is home to Archimonde and Kil'jaeden. Within the palace's crystal corridors are runes which fill the mind with despair, visions of conquest, and a rage to end all things: the creed of the Burning Legion, written in fire.",achievementID=12069},{m(1171,g({lvl=110,achievementID=12103,description="This zone serves as one of three zones on Argus and hosts the raid Antorus, the Burning Throne, dominating the western half of the zone. It is located inside the rift that bisects Argus."},{n(-4,{ach(12074,{o(277205,g({questID=49018,modelScale=2.5,icon="Interface\\Icons\\inv_misc_treasurechest04d",model="World\\Expansion06\\Doodads\\Eredar\\7er_Ancient_RaidChest01.mdx",description="This chest is located at |cFFFFFFFF65.40,40.4|r in Antoran Wastes in a cave. You will need |cFFFFD700Light's Judgment|r to get into the cave."},{s(90869,153308,{b=1,lvl=110,f=23})})),o(277207,g({questID=49020,modelScale=2.5,icon="Interface\\Icons\\inv_misc_treasurechest04d",model="World\\Expansion06\\Doodads\\Eredar\\7er_Ancient_RaidChest01.mdx",description="This chest is located at |cFFFFFFFF49,59|r in Antoran Wastes and located behind a fel waterfall near Worldsplitter Skuul."},{s(90829,153291,{b=1,lvl=110,f=28})})),o(277349,g({questID=49159,icon="Interface\\Icons\\inv_misc_treasurechest04d",modelScale=2.5,model="World\\Expansion06\\Doodads\\Eredar\\7eR_Ancient_RaidChest01.mdx"},{s(90823,153285,{b=1,lvl=110,f=4})}))})}),n(-25,{ach(12088,{crit(14,{achievementID=12088}),crit(15,{achievementID=12088}),crit(17,{achievementID=12088}),crit(18,{achievementID=12088}),crit(16,{achievementID=12088}),crit(13,{achievementID=12088})}),ach(12100,{p(2113,{itemID=153040,b=1}),ach(12089,{crit(14,{achievementID=12089}),crit(15,{achievementID=12089}),crit(17,{achievementID=12089}),crit(18,{achievementID=12089}),crit(16,{achievementID=12089}),crit(13,{achievementID=12089})}),ach(12091,{crit(3,{achievementID=12091}),crit(5,{achievementID=12091}),crit(2,{achievementID=12091}),crit(6,{achievementID=12091}),crit(4,{achievementID=12091}),crit(1,{achievementID=12091})}),ach(12092,{crit(3,{achievementID=12092}),crit(5,{achievementID=12092}),crit(2,{achievementID=12092}),crit(6,{achievementID=12092}),crit(4,{achievementID=12092}),crit(1,{achievementID=12092})}),ach(12093,{crit(3,{achievementID=12093}),crit(5,{achievementID=12093}),crit(2,{achievementID=12093}),crit(6,{achievementID=12093}),crit(4,{achievementID=12093}),crit(1,{achievementID=12093})}),ach(12094,{crit(3,{achievementID=12094}),crit(5,{achievementID=12094}),crit(2,{achievementID=12094}),crit(6,{achievementID=12094}),crit(4,{achievementID=12094}),crit(1,{achievementID=12094})}),ach(12095,{crit(3,{achievementID=12095}),crit(5,{achievementID=12095}),crit(2,{achievementID=12095}),crit(6,{achievementID=12095}),crit(4,{achievementID=12095}),crit(1,{achievementID=12095})}),ach(12096,{crit(3,{achievementID=12096}),crit(5,{achievementID=12096}),crit(2,{achievementID=12096}),crit(6,{achievementID=12096}),crit(4,{achievementID=12096}),crit(1,{achievementID=12096})}),ach(12097,{crit(3,{achievementID=12097}),crit(5,{achievementID=12097}),crit(2,{achievementID=12097}),crit(6,{achievementID=12097}),crit(4,{achievementID=12097}),crit(1,{achiev