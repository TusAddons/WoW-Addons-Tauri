tinsert(l,m(1007,g({description="|cff66ccffThe Broken Isles are a mysterious chain of islands located northeast of the raging Maelstrom. Littered with ancient elven ruins, they contain notably the mighty night elf city of Suramar as well as the long-lost Tomb of Sargeras. The third invasion of the Burning Legion commenced when the sealed portal inside the Tomb was opened again by Gul'dan from the alternate universe.|r",achievementID=11188,icon="Interface\\Icons\\Achievements_Zone_BrokenShore"},{m(1014,g({description="|cff66ccffDalaran moves to the Broken Isles as the mages of the Kirin Tor want to keep close to the events of the Burning Legion's third invasion from the Tomb of Sargeras, the fallen Titan and ravager of Worlds. The floating city receives several upgrades and can be found floating in the southern Broken Isles, south of Suramar and southeast of Azsuna. |r",icon="Interface\\Icons\\Spell_arcane_teleportdalaranbrokenisles",isRaid=true,lvl=98},{ach(11139,g({description="WARNING! This achievement will be removed with the release of Battle For Azeroth. MAKE SURE TO FINISH IT BEFORE THEN!"},{title(340,g({description="WARNING! This title will be removed with the release of Battle For Azeroth. MAKE SURE TO GET IT BEFORE THEN!\nNOTE: You should use Premade Group Finder. You have much better odds in a group.\n\nWARNING: You must drop or turn in duplicate quests otherwise you will be unable to loot anymore."},{crit(1,{description="Northwest Suramar.",itemID=139534,achievementID=11139,b=1,f=104}),crit(2,{description="Pirates in southern-east Azsuna.",itemID=139522,achievementID=11139,b=1,f=104}),crit(3,{description="Furbolgs in southern Val'sharah",itemID=139527,achievementID=11139,b=1,f=104}),crit(4,{description="Southwest Suramar City.",itemID=139535,achievementID=11139,b=1,f=104}),crit(5,{description="Grizzleweald (68, 73) in Val'sharah",itemID=139528,achievementID=11139,b=1,f=104}),crit(6,{description="Western Highmountain next to Skyhorn.",itemID=139524,achieve