tinsert(l,m(962,g({description="|cff66ccffDraenor, called Rakshar (the Sunstone) by the arakkoa and Dawgar (the Known Earth) by the ogres, was the homeworld of the orcish race and the last refuge of the draenei before their arrival on Azeroth. It was a large, fertile world dominated by vast plains, dense forests, and lush swamps. Besides the orcs and draenei it was originally home to many other intelligent humanoid races, including the ancient, bird-like arakkoa; the mighty ogres and their brutal gronn masters; and the aggressive tree-men known as botani.|r",achievementID=8935,icon="Interface\\Icons\\Achievement_Zone_Draenor_01"},{m(976,g({lvl=90,races=a0,maps={980,981,982},description="|cff66ccffFrostwall is the Horde Garrison, located in Frostfire Ridge. A fully-upgraded Frostwall garrison is considered to be a fortress.|r",isRaid=true,icon="Interface\\Icons\\achievement_garrison_tier01_horde"},{n(-3,g({races=a0},{n(-58,g({u=26,achievementID=1656},{n(-25,g({races=a0},{n(96362,g({races=a0,description="Purchasing Ghoulish Guises, Hallow's Glow, Seer's Invitation, Witch's Brew or Creepy Crawlers for 5x|cFFFFD700Spooky Supplies|r will enable you to use the decorations year round."},{i(128658,g({u=25,b=1,f=102},{i(128664,g({description="In order to summon Ghastly Rats, Ghost Maggots, and Spectral Spinners you will need to do the dailies in your Garrison.  Once you have gotten enough |cFFFFD700Spooky Supplies|r you can then purchase from Izzy Hollyfizzle the |cFFFFD700Creepy Crawlers|r and this will cause Ghastly Rats, Ghost Maggots, and Spectral Spinners to spawn.",b=1,f=102,u=26},{p(1741),p(1740),p(1730)}))}))}))})),n(-17,g({u=26,races=a0},{n(96705,g({races=a0,description="These daily quests take place in Shadowmoon Valley and reward |cFFFFD700Spooky Supplies|r."},{q(39721,{races=a0}),q(39720,{races=a0}),q(39719,{races=a0}),q(39716,{races=a0})}))})),n(-2,g({races=a0},{n(96362,g({races=a0,description="Purchasing Ghoulish Guises, Hallow's Glow, Seer's Invitation, Witch'