pawn available, though. |nOnce the Sapphire Firefly has been captured or defeated, a new one will immediately pop up in the zone. It can appear at the same location in which it was captured, or it can respawn elsewhere."}),p(568),p(379),p(401),p(1590),p(1456),p(1593),p(1582)}),n(-17,{q(34883,{s(63605,114723,{b=1,f=7}),s(63606,114724,{b=1,f=4}),s(63607,114725,{b=1,f=6}),s(63608,114726,{b=1,f=5})}),q(35482,g({races=a1},{s(63933,114945,{b=1,f=8}),s(66417,118079,{b=1,f=25}),s(66421,118083,{b=1,f=25}),s(66424,118086,{b=1,f=23}),s(66418,118080,{b=1,f=26}),s(66419,118081,{b=1,f=32}),s(66420,118082,{b=1,f=20}),s(66422,118084,{b=1,f=29}),s(66423,118085,{b=1,f=28})})),q(36183,g({races=a0},{s(63933,114945,{b=1,f=8}),s(66417,118079,{b=1,f=25}),s(66421,118083,{b=1,f=25}),s(66424,118086,{b=1,f=23}),s(66418,118080,{b=1,f=26}),s(66419,118081,{b=1,f=32}),s(66420,118082,{b=1,f=20}),s(66422,118084,{b=1,f=29}),s(66423,118085,{b=1,f=28})})),q(34939,{s(63601,114719,{b=1,f=5}),s(63602,114720,{b=1,f=7}),s(63603,114721,{b=1,f=4}),s(63604,114722,{b=1,f=6})}),q(35077,{s(66412,118074,{b=1,f=4}),s(66411,118073,{b=1,f=5}),s(66410,118072,{b=1,f=6}),s(66409,118071,{b=1,f=7})}),q(34999,{s(63597,114715,{b=1,f=7}),s(63598,114716,{b=1,f=4}),s(63599,114717,{b=1,f=6}),s(63600,114718,{b=1,f=5})}),q(34656,{s(63614,114732,{b=1,f=5}),s(63615,114733,{b=1,f=7}),s(63616,114734,{b=1,f=4}),s(63617,114735,{b=1,f=6})}),q(35273,{s(63609,114727,{b=1,f=7}),s(63610,114728,{b=1,f=4}),s(63611,114729,{b=1,f=6}),s(63612,114730,{b=1,f=5})}),q(34829,{s(63618,114736,{b=1,f=7}),s(63619,114737,{b=1,f=4}),s(63620,114738,{b=1,f=6}),s(63621,114739,{b=1,f=5})}),q(35211,{s(66426,118088,{b=1,f=4}),s(66428,118090,{b=1,f=5}),s(66427,118089,{b=1,f=6}),s(66425,118087,{b=1,f=7})}),q(35004,{s(63935,114949,{b=1,f=3}),s(63936,114954,{b=1,f=3}),s(63937,114955,{b=1,f=3}),s(66820,119053,{b=1,f=3}),s(66825,119058,{b=1,f=3})}),q(35012,{s(63594,114712,{b=1,f=7}),s(63595,114713,{b=1,f=6}),s(63596,114714,{b=1,f=5}),s(63613,114731,{b=1,f=4})}),q(349