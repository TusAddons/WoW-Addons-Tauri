=10596,itemID=139659,b=1,f=56})})),i(133709,g({description="The short buff will eventually expire and this item will disappear from your inventory. When it does, the attached mob will spawn.",lvl=98},{n(102347,g({description="After the short buff expires, this mob spawns. Kill it for the lure."},{i(133710,{dr=95})}))})),i(133721,g({description="I hope that someone gets my...\nI hope that someone gets my...\nMESSAGE IN A BOOOOTTTLE, yeah.",lvl=98},{i(133722)})),i(133713,g({description="An important note - if you use this item with another bait active (or vice versa) the new buff WILL REPLACE the previous one! As such, it's best to wait until your bait buff expires before using this item. This does not apply to Arcane Lure, which can be used concurrently with any other bait/lure.",lvl=98},{i(133714)})),i(133707,g({description="This item will allow you to catch the Rare fish Terrorfin in Val'sharah.",lvl=98},{crit(17,{achievementID=10596,itemID=133728,b=1,f=56}),crit(17,{achievementID=10596,itemID=139655,b=1,f=56})})),i(133703,g({description="This item will allow you to catch the Rare fish Nar'thalas Hermit in Azsuna.",lvl=98},{crit(11,{achievementID=10596,itemID=133726,b=1,f=56}),crit(11,{achievementID=10596,itemID=139653,b=1,f=56})})),i(133795,g({description="This item will allow you to catch the Rare fish Ancient Black Barracuda from all Coastal Waters in the Broken Isles.",lvl=98},{crit(1,{achievementID=10596,itemID=133742,b=1,f=56}),crit(1,{achievementID=10596,itemID=139669,b=1,f=56})})),i(133705,g({description="This item that will attract a Lorlathil Druid that casts The Cat's Meow buff on you, increasing your chance to fish up Ancient Mossgill.",lvl=98},{n(102349,g({description="Casts The Cat's Meow buff on you, increasing your chance to fish up Ancient Mossgill."},{sp(201809,{crit(3,{achievementID=10596,itemID=133730,b=1,f=56}),crit(3,{achievementID=10596,itemID=139657,b=1,f=56})})}))})),i(133704,g({description="This item will give you a buff that will allow you to see and fish from Ghostly Queenfish schools.",lvl=98},{sp(201807,{crit(6,{achievementID=10596,itemID=133727,b=1,f=56}),crit(6,{achievementID=10596,itemID=139654,b=1,f=56})})})),i(133710,g({description="This item will allow you to catch the Rare fish Ancient Highmountain Salmon in Highmountain.",lvl=98},{crit(2,{achievementID=10596,itemID=133733,b=1,f=56}),crit(2,{achievementID=10596,itemID=139660,b=1,f=56})})),i(133714,g({description="This item will allow you to catch the Rare fish Thundering Stormray in Stormheim.",lvl=98},{crit(15,{achievementID=10596,itemID=133736,b=1,f=56}),crit(15,{achievementID=10596,itemID=139663,b=1,f=56})})),i(133701,g({description="You receive the buff Skrog Toenail; on expiration of this buff, a Murloc mob is summoned. When killed, this mob will drop Aromatic Murloc Slime.",lvl=98},{n(102338,{i(133702,{dr=93})})})),i(133719,g({description="Using this item will awaken a Confused Seerspine Murloc, who will run around briefly and drop some Seerspine Puffer (as well as other fish) onto the ground/water nearby.",lvl=98},{n(102350,g({description="Runs around briefly and drop some Seerspine Puffer (as well as other fish) onto the ground/water nearby.\n\nIn order to collect the fish, you simply have to run over them - they will be added to your bags."},{crit(16,{achievementID=10596,itemID=133738,b=1,f=56}),crit(16,{achievementID=10596,itemID=139665,b=1,f=56})}))})),i(133716,g({description="This item will allow you to catch the Rare fish Graybelly Lobster in Stormheim.",lvl=98},{crit(7,{achievementID=10596,itemID=133735,b=1,f=56}),crit(7,{achievementID=10596,itemID=139662,b=1,f=56})})),i(133723,g({description="This item will spawn a Landlocked Shark, which will yield 7-9 Seabottom Squid when killed. Note that this item only has a 1 minute duration in your bags, and it will disappear if you don't use it by then!",lvl=98},{n(102359,g({description="Drops 7-9 Seabottom Squid when killed."},{crit(13,{achievementID=10596,itemID=133741,b=1,f=56}),cr